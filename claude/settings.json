{
  "env": {
    "ENABLE_LSP_TOOL": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "WebFetch",
      "Bash(ag:*)",
      "Bash(bun:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(gh api:*)",
      "Bash(ls:*)",
      "Bash(diff:*)",
      "Bash(find:*)",
      "Bash(gemini:*)",
      "Bash(codex:*)",
      "Bash(osascript:*)",
      "Bash(summarize:*)",
      "WebSearch"
    ],
    "deny": [
      "Read(.env*)",
      "Write(.env*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(sudo:*)",
      "Bash(rm:*)",
      "Bash(curl:*)",
      "Read(./.entire/metadata/**)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [],
    "SessionEnd": [],
    "UserPromptSubmit": [],
    "Stop": [],
    "PreToolUse": [],
    "PostToolUse": []
  },
  "enabledPlugins": {
    "ruby-skills@ruby-skills": true,
    "ruby-lsp@ruby-skills": true,
    "hr-skills@smartbank-agent-skills": true,
    "presentation-skills@smartbank-agent-skills": true,
    "codex@openai-codex": true,
    "superpowers@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "skipAutoPermissionPrompt": true,
  "agentPushNotifEnabled": true
}
